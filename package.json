{
  "name": "paroquia-nossa-senhora-das-gracas",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "bash scripts/ensure-db-tunnel.sh",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=paroquia-web",
    "dev:api": "turbo run dev --filter=paroquia-api",
    "dev:local": "USE_LOCAL_DB=1 turbo run dev",
    "db:tunnel": "bash scripts/db-tunnel.sh",
    "db:check": "turbo run db:check --filter=paroquia-api",
    "db:studio": "turbo run db:studio --filter=paroquia-api",
    "db:sync:prod": "bash scripts/db-sync-to-production.sh",
    "db:heic:deps": "bash scripts/install-heic-deps.sh",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "turbo run prisma:migrate --filter=paroquia-api",
    "db:seed": "turbo run prisma:seed --filter=paroquia-api",
    "db:reset": "turbo run prisma:reset --filter=paroquia-api"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  }
}
