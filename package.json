{
  "name": "paroquia-nossa-senhora-das-gracas",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["web", "api"],
  "scripts": {
    "predev": "bash scripts/ensure-db-tunnel.sh",
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "dev:local": "USE_LOCAL_DB=1 npm run dev --workspaces --if-present",
    "db:tunnel": "bash scripts/db-tunnel.sh",
    "db:check": "npm run db:check -w api",
    "db:studio": "npm run db:studio -w api",
    "db:sync:prod": "bash scripts/db-sync-to-production.sh",
    "db:heic:deps": "bash scripts/install-heic-deps.sh",
    "build": "npm run build -w api && npm run build -w web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:seed": "npm run prisma:seed -w api",
    "db:reset": "npm run prisma:reset -w api"
  }
}
