# Requer apps/api/.env (JWT_SECRET e demais configs). Este arquivo só troca o banco.
# Se este arquivo existir, npm run dev usa o banco de PRODUÇÃO automaticamente.
# Túnel SSH abre sozinho — não precisa de terminal extra.
#
# Setup (uma vez):
#   cp api/.env.production.local.example api/.env.production.local
#   nano api/.env.production.local
#
# Para voltar ao banco local: renomeie ou apague este arquivo, ou use npm run dev:local

VPS_HOST=84.46.251.102
VPS_USER=root
# Deixe vazio para usar ~/.ssh/deploy_paroquia ou id_ed25519 automaticamente
VPS_SSH_KEY=
DB_TUNNEL_PORT=15432

DATABASE_URL=postgresql://paroquia:SUA_SENHA_PRODUCAO@127.0.0.1:15432/paroquia?schema=public
