FROM node:20-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json .npmrc turbo.json ./
COPY apps/api/package.json ./apps/api/package.json

RUN npm ci --include=dev

COPY apps/api ./apps/api

RUN npx turbo run build --filter=paroquia-api

FROM node:20-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
    libheif1 libheif-examples \
    imagemagick \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc turbo.json ./
COPY apps/api/package.json ./apps/api/package.json

RUN npm ci --omit=dev --workspace=paroquia-api && npm install -w paroquia-api prisma tsx --no-save

# Mantém /app/api no container para compatibilidade com volumes de produção existentes
COPY --from=builder /app/apps/api/dist ./api/dist
COPY apps/api/prisma ./api/prisma

WORKDIR /app
RUN npx prisma generate --schema=./api/prisma/schema.prisma

WORKDIR /app/api

ENV NODE_ENV=production
EXPOSE 3333

CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
