FROM node:20-bookworm-slim AS builder

WORKDIR /app

COPY package.json package-lock.json .npmrc turbo.json ./
COPY apps/api/package.json ./apps/api/package.json

RUN npm ci --include=dev

COPY apps/api ./apps/api

RUN npx turbo run build --filter=paroquia-api

FROM node:20-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
    libheif1 libheif-examples \
    imagemagick \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json .npmrc turbo.json ./
COPY apps/api/package.json ./apps/api/package.json

RUN npm ci --omit=dev --workspace=paroquia-api \
  && npm install prisma@6.16.2 tsx --no-save

# Mantém /app/api no container para compatibilidade com volumes de produção existentes
COPY --from=builder /app/apps/api/dist ./api/dist
COPY apps/api/prisma ./api/prisma
COPY --from=builder /app/apps/api/node_modules/.prisma ./api/node_modules/.prisma
COPY --from=builder /app/apps/api/node_modules/@prisma/client ./api/node_modules/@prisma/client

WORKDIR /app/api

ENV NODE_ENV=production
EXPOSE 3333

CMD ["sh", "-c", "../node_modules/.bin/prisma migrate deploy && node dist/server.js"]
