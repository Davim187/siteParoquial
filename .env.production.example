# Copie para .env.production no servidor: cp .env.production.example .env.production

POSTGRES_USER=paroquia
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=paroquia
POSTGRES_PORT=5432

# URL interna Docker (host postgres = serviço no compose)
DATABASE_URL=postgresql://paroquia:troque-esta-senha-forte@postgres:5432/paroquia?schema=public

HTTP_PORT=80
ACME_EMAIL=secretariaparoquialpnsg.psm@gmail.com

# Deixe vazio se o site e a API usam o mesmo domínio (Nginx faz proxy de /api)
VITE_API_URL=

JWT_SECRET=troque-esta-chave-em-producao-minimo-32-caracteres-aleatoria
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# URL pública do site (sem barra no final)
CORS_ORIGIN=https://paroquiansdasgracas.com.br
PUBLIC_URL=https://paroquiansdasgracas.com.br

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
