# Copie para .env.production no servidor: cp .env.production.example .env.production

POSTGRES_USER=paroquia
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=paroquia
POSTGRES_PORT=5432

HTTP_PORT=80

# Deixe vazio se o site e a API usam o mesmo domínio (Nginx faz proxy de /api)
VITE_API_URL=

JWT_SECRET=troque-esta-chave-em-producao-minimo-32-caracteres-aleatoria
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# URL pública do site (sem barra no final)
CORS_ORIGIN=http://84.46.251.102
PUBLIC_URL=http://84.46.251.102

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
